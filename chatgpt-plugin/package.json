{
  "name": "cut-video-chatgpt-plugin",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Compagnon MCP pour synchroniser la bibliothèque Cut Vidéo, préparer les métadonnées et les programmations sans envoyer les fichiers vidéo.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "express": "latest",
    "redis": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
